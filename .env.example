# Copy to .env and fill in.

# Secret used to sign login tokens. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
APP_JWT_SECRET=

# Host port (bound to 127.0.0.1) used by docker-compose.yml. Pick any free port.
FAKEJIRA_PORT=8081

# Name of the Docker network your Caddy container is on
# (only used with docker-compose.caddy.yml).
CADDY_NETWORK=caddy

# Public URL of the app, used for links in emails and invites (password reset,
# notifications, invite links). Recommended. If left empty, the address an admin
# opens the app at is used once they sign in.
APP_BASE_URL=https://jira.example.com

# Database password (user "sa"). Recommended; required for database network
# access (docker-compose.db.yml). An existing database without a password is
# switched to this one on the next start. Once set, keep it: removing or
# changing it here later locks the app out of the database.
SPRING_DATASOURCE_PASSWORD=

# Host port for database network access (only used with docker-compose.db.yml).
FAKEJIRA_DB_PORT=9092

# --- Email (optional) -------------------------------------------------------
# Leave SPRING_MAIL_HOST empty to disable email. Without email, password reset
# links are written to the container log (docker logs fakejira) instead.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=FakeJIRA <no-reply@example.com>

# --- Sign-up -----------------------------------------------------------------
# Initial sign-up mode: OPEN, APPROVAL (admin approves new accounts) or INVITE
# (invite links only). Admins can change it any time on the Admin page; this
# only applies until then. The first account ever created becomes the admin.
APP_REGISTRATION_DEFAULT_MODE=OPEN

# --- Rate limiting -----------------------------------------------------------
# Sign-in, sign-up and password reset are rate limited per client IP. Behind
# Cloudflare + Caddy the real IP comes from these headers (first match wins).
# If the app is reachable directly (not only through your proxy), set this to
# an empty value so clients cannot spoof the header.
APP_RATE_LIMIT_CLIENT_IP_HEADERS=CF-Connecting-IP,X-Forwarded-For

# --- Backups -----------------------------------------------------------------
# Nightly backup of the database and attachments into /data/backups (inside
# the data volume). Spring cron format: sec min hour day month weekday; "-"
# turns scheduled backups off. APP_BACKUP_KEEP = how many to keep.
APP_BACKUP_CRON=0 30 3 * * *
APP_BACKUP_KEEP=14

# --- Email digests -----------------------------------------------------------
# When daily/weekly digests are sent (weekly ones go out on Mondays).
APP_DIGEST_CRON=0 0 7 * * *

# --- Automation ----------------------------------------------------------------
# How often scheduled automation rules (SLA escalation, stale tasks) run.
APP_AUTOMATION_CRON=0 */5 * * * *

# --- Off-site backups (optional) -------------------------------------------------
# Every backup is also uploaded to S3-compatible storage (AWS S3, Cloudflare R2,
# Backblaze B2, MinIO) and/or a WebDAV folder (e.g. Nextcloud). Off when empty.
APP_BACKUP_S3_ENDPOINT=
APP_BACKUP_S3_BUCKET=
APP_BACKUP_S3_REGION=us-east-1
APP_BACKUP_S3_ACCESS_KEY=
APP_BACKUP_S3_SECRET_KEY=
APP_BACKUP_S3_PREFIX=fakejira/
APP_BACKUP_S3_PATH_STYLE=true
APP_BACKUP_WEBDAV_URL=
APP_BACKUP_WEBDAV_USERNAME=
APP_BACKUP_WEBDAV_PASSWORD=

# --- PostgreSQL (optional, docker-compose.postgres.yml) ---------------------------
# Password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=
# First start on PostgreSQL only: copy the data from the old H2 database once,
# then remove these lines.
APP_MIGRATE_FROM_URL=
APP_MIGRATE_FROM_PASSWORD=

# --- Monitoring ------------------------------------------------------------------
# Bearer token for Prometheus metrics at /api/metrics. Off when empty.
APP_METRICS_TOKEN=
# Daily check for a newer FakeJIRA release (shown to admins). true or false.
APP_UPDATE_CHECK=true

# --- Email in (optional) -----------------------------------------------------------
# Reply-by-email and email-to-task. The mailbox must accept plus-addressing
# (jira+anything@example.com). Either poll it over IMAPS...
APP_MAIL_INBOUND_ADDRESS=
APP_MAIL_INBOUND_IMAP_HOST=
APP_MAIL_INBOUND_IMAP_USERNAME=
APP_MAIL_INBOUND_IMAP_PASSWORD=
# ...or let an inbound-mail service POST to /api/inbound/email with this secret
# in the X-Inbound-Secret header.
APP_MAIL_INBOUND_SECRET=

# --- Sign in with Google / GitHub (optional) ----------------------------------------
# Callback URLs: <APP_BASE_URL>/api/auth/oauth/google/callback and .../github/callback
APP_OAUTH_GOOGLE_CLIENT_ID=
APP_OAUTH_GOOGLE_CLIENT_SECRET=
APP_OAUTH_GITHUB_CLIENT_ID=
APP_OAUTH_GITHUB_CLIENT_SECRET=

# Time zone for the schedules above (default UTC), e.g. Europe/Budapest.
TZ=UTC
